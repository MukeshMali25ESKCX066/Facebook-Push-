PORT=4000
# Set to the deployed frontend origin in production (for example https://pagecrew.vercel.app).
FRONTEND_URL=http://127.0.0.1:5173
DEMO_MODE=false

# Set strong, private values before starting the backend.
ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters-long
# Optional data directory. On Render, mount a persistent disk and point this to its mount path.
# PAGECREW_DATA_DIR=/var/data/pagecrew-data
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# AI content generation and image variations use Gemini from the backend.
# Create a key in Google AI Studio; never expose it to the frontend.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional cost-estimation rates; configure using current Google pricing.
GEMINI_INPUT_USD_PER_MILLION_TOKENS=
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=
GEMINI_IMAGE_USD_PER_IMAGE=

# Optional OpenAI feature: Analytics AI recommendations only.
OPENAI_API_KEY=
# Optional provider pricing for estimated per-campaign usage costs (USD).
OPENAI_INPUT_USD_PER_MILLION_TOKENS=
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=

# Optional: GA4 Data API reporting. Grant the service account Viewer access to the GA4 property.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# Optional: PostgreSQL connection for account data.
DATABASE_URL=
