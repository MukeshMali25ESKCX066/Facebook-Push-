{
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "https://facebook-push.onrender.com/p/:slug"
    },
    {
      "source": "/api/:path*",
      "destination": "https://facebook-push.onrender.com/api/:path*"
    },
    {
      "source": "/advanced-hybrid",
      "destination": "/advanced-hybrid.html"
    },
    {
      "source": "/advanced-hybrid/",
      "destination": "/advanced-hybrid.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
